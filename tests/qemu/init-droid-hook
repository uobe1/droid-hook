#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Minimal arm64 initramfs init for the droid-hook QEMU load gate.
#
# It loads droid_hook.ko with selftest=1, asserts the in-module self-test ran,
# unloads the module, and asserts no module/symbol residue is left.  Every
# failure prints a DH_QEMU_FAIL marker and powers off; the workflow greps the
# serial log, so a failure can never pass silently.

BB=/bin/busybox
export PATH=/sbin:/bin:/usr/sbin:/usr/bin

"$BB" mount -t proc proc /proc
"$BB" mount -t sysfs sysfs /sys
if ! "$BB" mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
	"$BB" mount -t tmpfs tmpfs /dev
	"$BB" mknod /dev/console c 5 1
	"$BB" mknod /dev/null c 1 3
fi
"$BB" mkdir -p /dev/pts /tmp
"$BB" mount -t devpts devpts /dev/pts 2>/dev/null

fail() {
	echo "DH_QEMU_FAIL $*"
	"$BB" poweroff -f
	sleep 5
	exit 1
}

echo "DH_QEMU_BOOT $(cat /proc/sys/kernel/osrelease)"

# Start from an empty ring buffer so the residue scan below covers only the
# window from insmod to rmmod: a pre-existing warning must not be attributed
# to this module, and a module warning must not hide in boot noise.
"$BB" dmesg -c > /dev/null || fail dmesg_clear

"$BB" insmod /modules/droid_hook.ko selftest=1 || fail insmod
[ -e /sys/module/droid_hook ] || fail module_dir_missing
"$BB" dmesg | "$BB" grep -q 'DH_SELFTEST_OK' || fail selftest_marker
echo "DH_QEMU_LOADED abi=5"

"$BB" rmmod droid_hook || fail rmmod
if [ -e /sys/module/droid_hook ]; then
	fail module_dir_stale
fi
lsmod_count=$("$BB" lsmod | "$BB" grep -c '^droid_hook')
echo "DH_QEMU_LSMOD_COUNT=$lsmod_count"
[ "$lsmod_count" -eq 0 ] || fail lsmod_stale
"$BB" dmesg | "$BB" grep -q 'droid_hook: unloaded' || fail unload_marker
# An unexported module symbol that survived rmmod would still show in kallsyms.
if "$BB" grep -q ' dh_ctx_init' /proc/kallsyms; then
	fail symbol_stale
fi
# Failure/residue signatures, scanned over the insmod..rmmod dmesg window.
if "$BB" dmesg | "$BB" grep -Eq 'BUG:|Oops|panic|invalid module format|\[permanent\]|WARNING:|Call trace'; then
	fail kernel_warning_after_unload
fi

echo "DH_QEMU_UNLOADED"
echo "DH_QEMU_OK"
"$BB" poweroff -f
